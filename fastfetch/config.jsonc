{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": {
            "top": 1,
            "left": 2
        }
    },
    "display": {
        "separator": "  "
    },
    "modules": [
        "title",
        "os",
        "kernel",
        "uptime",
        "memory",
        {
            "type": "disk",
            "folders": "/home/container"
        },
        "break",
        "colors"
    ]
}
